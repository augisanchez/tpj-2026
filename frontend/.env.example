# WPGraphQL endpoint for the WordPress backend.
# Local dev points at the LocalWP site; production points at the
# headless WP origin (e.g. https://cms.thephotographicjournal.com/graphql).
WORDPRESS_API_URL=http://tpj.local/graphql

# Cloudflare-fronted media origin. When unset, TpjImage and the
# article-body HTML rewriter return plain origin URLs (pre-cutover
# behaviour). When set, every image routes through Cloudflare Image
# Resizing at the edge and the frontend builds a responsive srcset.
#
# Format: scheme + host, no trailing slash. e.g.
# NEXT_PUBLIC_CDN_BASE=https://media.thephotographicjournal.com
# NEXT_PUBLIC_CDN_BASE=
